# SQL Analyst Agent Configuration
# Supported providers: local | ollama | gemini | openai
AGENT_PROVIDER=local
AGENT_MODEL=deterministic-bilingual-v1

# Optional external LLM provider settings
AGENT_OLLAMA_BASE_URL=http://localhost:11434
AGENT_GEMINI_API_KEY=
AGENT_OPENAI_API_KEY=
AGENT_OPENAI_BASE_URL=https://api.openai.com/v1

# Database & Read-Only Sandbox Limits
AGENT_DB_PATH=data/analytics.db
AGENT_MAX_RETRIES=3
AGENT_MAX_ROWS=200
AGENT_QUERY_TIMEOUT_SEC=5.0
AGENT_REQUEST_TIMEOUT_SEC=30.0
AGENT_EVAL_REPORT_PATH=eval/latest_report.json
AGENT_LOG_LEVEL=INFO
